rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Agent Release Zips ────────────────────────────────────────────────────
    // Agents download release zips via public HTTP GET URL.
    // Writes are restricted to Admin SDK only.
    match /agent-releases/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }

    // ─── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
